# Credenciais AWS. Permissões no bucket: s3:PutObject e s3:GetObject
# (dashboards) e, para objetos públicos (--public), s3:PutObjectAcl.
ACCESS_KEY=
PRIVATE_KEY=
# AWS_DEFAULT_REGION também é aceita
AWS_REGION=us-east-1

# Senha exigida para upload real (interface gráfica e web)
UPLOAD_PASSWORD=defina_uma_senha_aqui

# Interface web
WEB_HOST=127.0.0.1
WEB_PORT=5000
# Hosts aceitos, separados por vírgula (padrão: 127.0.0.1:PORTA,localhost:PORTA).
# Atrás do nginx, inclua o domínio público, ex.: upload.exemplo.org
WEB_ALLOWED_HOSTS=
# Chave fixa das sessões (opcional). Gere com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=
